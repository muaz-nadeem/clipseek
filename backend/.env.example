# Local development. Copy to .env and configure your own database credentials.

IVS_ENV=development
IVS_DEV_AUTH_BYPASS=0
IVS_DATABASE_URL=dbname=intelligent_video_search user=postgres host=localhost
IVS_REDIS_URL=redis://localhost:6379/0
IVS_REQUIRE_REDIS=0
IVS_REQUIRE_PGVECTOR=0
# Sample the whole video at approximately 5 fps. Set IVS_INDEX_STRIDE=1 for every frame.
IVS_INDEX_TARGET_FPS=5
IVS_CLIP_BATCH_SIZE=8
# Shared CPU inference threads. Default: min(4, logical CPU count).
IVS_TORCH_THREADS=4
IVS_EMBED_MIN_GAP_SEC=0.5
IVS_EMBED_HEARTBEAT_SEC=2
# Whole-frame CLIP check every N seconds so queries can match things detector crops miss (0 disables).
IVS_SCENE_INTERVAL_SEC=2
# Store a new appearance when CLIP similarity to the last stored vector drops below this.
IVS_CHANGE_THRESHOLD=0.90
# Search returns only candidates above this floor and within this margin of the best score.
IVS_SEARCH_MIN_SCORE=0.23
IVS_SEARCH_SCORE_MARGIN=0.04
IVS_MAX_DURATION_SEC=600
# Load YOLO + CLIP in the background at API startup.
IVS_WARM_MODELS=1
# Optional: real password-reset emails. Without SMTP, development shows the reset link on screen.
# IVS_SMTP_HOST=smtp.example.com
# IVS_SMTP_PORT=587
# IVS_SMTP_USER=
# IVS_SMTP_PASSWORD=
# IVS_SMTP_FROM=noreply@example.com
IVS_JWT_SECRET=change-this-to-a-long-random-secret-32chars
IVS_JWT_EXPIRE_MINUTES=10080
IVS_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
IVS_PUBLIC_APP_URL=http://127.0.0.1:5173
